# ============================================
# SERVER CONFIGURATION
# ============================================
# Порт на който ще работи backend сървърът
PORT=5000

# Режим на работа (development, production, test)
NODE_ENV=development

# URL на frontend приложението (за CORS)
FRONTEND_URL=http://localhost:5173

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/your_database?schema=public"

# ============================================
# JWT (JSON Web Tokens)
# ============================================
# Secret ключ за подписване на JWT токени
# ВАЖНО: Генерирай силен random string с:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# Колко дълго токенът е валиден (7d = 7 дни, 1h = 1 час, 30m = 30 минути)
JWT_EXPIRES_IN=7d

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Gmail акаунт за изпращане на emails (забравена парола и т.н.)
EMAIL_USER=your_email@gmail.com

# Gmail App Password (НЕ обикновената парола!)
# Генерирай от: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here

# ============================================
# APPLICATION CONFIG
# ============================================
# ДДС процент (0.20 = 20%)
DEFAULT_TAX_RATE=0.20

# Колко резултата да показва по подразбиране при pagination
DEFAULT_PAGINATION_LIMIT=20

# Максимален брой резултати при pagination
MAX_PAGINATION_LIMIT=100

# Stripe
STRIPE_PRICE_ID=price_example
STRIPE_SECRET_KEY=sk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
